{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "name": "StaffPortal - Employee HRMS",
  "short_name": "StaffPortal",
  "description": "Enterprise Employee Lifecycle, Attendance Punch Terminal, and HR Management System",
  "id": "/?source=pwa",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#070913",
  "theme_color": "#4f46e5",
  "lang": "en-US",
  "dir": "ltr",
  "categories": ["business", "productivity", "utilities"],
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png"
    },
    {
      "src": "/favicon.svg",
      "sizes": "48x48",
      "type": "image/svg+xml"
    }
  ],
  "shortcuts": [
    {
      "name": "Attendance & Punch Clock",
      "short_name": "Punch In",
      "description": "Open live workday punch clock and timesheet",
      "url": "/attendance",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Employees Directory",
      "short_name": "Employees",
      "description": "Search and browse corporate employee roster",
      "url": "/employees",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Holidays & Announcements",
      "short_name": "Holidays",
      "description": "Company holiday calendar and corporate bulletin",
      "url": "/holidays",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "My Profile",
      "short_name": "Profile",
      "description": "View and edit personal employee profile",
      "url": "/profile",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    }
  ],
  "prefer_related_applications": false
}

